#!/usr/bin/env python3
"""Validate Conventional Commits before Git creates a commit."""
from pathlib import Path
import re
import subprocess
import sys

HEADER = re.compile(r"[a-z][a-z0-9_-]*(?:\(([^()\r\n]+)\))?!?: \S(?:.*\S)?", re.IGNORECASE)


def main():
    if len(sys.argv) != 2:
        print("Usage: commit-msg MESSAGE_FILE", file=sys.stderr)
        return 2
    try:
        message = Path(sys.argv[1]).read_text(encoding="utf-8")
        cleaned = subprocess.run(["git", "stripspace", "--strip-comments"], input=message,
                                 text=True, capture_output=True, check=True).stdout
    except (OSError, UnicodeError, subprocess.CalledProcessError) as error:
        print(f"Cannot read commit message: {error}", file=sys.stderr)
        return 2

    lines = cleaned.splitlines()
    subject = lines[0] if lines else ""
    while re.match(r"^(?:fixup|squash|amend)! ", subject):
        subject = subject.split("! ", 1)[1]
    if subject.startswith("Merge ") or re.fullmatch(r'Revert ".+"', subject):
        return 0
    match = HEADER.fullmatch(subject)
    if match and (match[1] is None or match[1] == match[1].strip()) and (len(lines) < 2 or not lines[1]):
        return 0

    print("Use Conventional Commits: type(scope): summary\n"
          "Example: fix(power): recover from transient helper disconnects\n"
          "Scope is optional. Separate the subject and body with a blank line.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())

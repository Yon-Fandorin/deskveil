    "연결 필요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection needed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 필요"
          }
        }
      }
    },
    "설치 필요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation needed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 필요"
          }
        }
      }
    },
    "덮개를 닫아도 계속 실행하는 기능에 사용합니다. 처음 설치와 보조 도구 변경 시에만 관리자 승인이 필요합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to keep work running with the lid closed. Administrator approval is required for initial installation and helper changes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫아도 계속 실행하는 기능에 사용합니다. 처음 설치와 보조 도구 변경 시에만 관리자 승인이 필요합니다."
          }
        }
      }
    },
    "키보드·마우스는 막히고, 자동화의 클릭·입력은 동작하는지 확인해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that physical keyboard and mouse input is blocked while automation clicks and typing still work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드·마우스는 막히고, 자동화의 클릭·입력은 동작하는지 확인해주세요."
          }
        }
      }
    },
    "접근 권한에서 입력 차단 연결을 복구해주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore input blocking in Permissions."
